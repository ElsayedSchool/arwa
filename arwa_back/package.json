    "cron": "^4.3.3",
    "dotenv": "^17.2.1",
    "firebase-admin": "^13.5.0",
    "glob": "^11.0.3",
    "google-auth-library": "^10.3.0",
    "googleapis": "^159.0.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "lz-string": "^1.5.0",
