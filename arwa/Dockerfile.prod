# ---------- Build Stage ----------
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies (only production + dev needed to build)
COPY package*.json ./
# Using npm install because repo has no lock file in sync for npm ci
RUN npm install --no-audit --no-fund

# Copy rest of source
COPY . .

# Accept a build-arg to override base path (maps to VITE_BASE_PATH env)
ARG BASE_PATH=/arwa/
ENV VITE_BASE_PATH=$BASE_PATH

# Build (includes type-check via tsc -b in package script)
RUN npm run build

# ---------- Runtime Stage ----------
FROM nginx:stable-alpine AS runtime
# Copy custom nginx config
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
# Copy built assets
COPY --from=build /app/dist /usr/share/nginx/html

# Security: drop default index listing, ensure permissions
# (Note) Running as root (default in official nginx image) so master can bind to port 80 then workers drop privileges.
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O - http://127.0.0.1/ || exit 1
CMD ["nginx","-g","daemon off;"]
